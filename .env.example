# Plantilla de variables de entorno.
# Copia este archivo a ".env" y completa los valores reales de forma local.
# NUNCA subas ".env" al repositorio ni compartas su contenido.

# --- Backend / Gemini (uso exclusivo del servidor; NO usar prefijo VITE_) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Lista opcional separada por comas. Solo agrega modelos verificados para tu API key.
GEMINI_FALLBACK_MODELS=
PORT=8787
HOST=127.0.0.1
HEALTH_CHECK_TOKEN=your_local_health_token_here

# --- Frontend ---
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# --- Gmail / Python API ---
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback/google
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
FRONTEND_URL=http://localhost:5173
