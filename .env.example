# Plantilla de variables de entorno.
# Copia este archivo a ".env" y completa los valores reales de forma local.
# NUNCA subas ".env" al repositorio ni compartas su contenido.

# --- Backend / Gemini (uso exclusivo del servidor; NO usar prefijo VITE_) ---
# API key de Google Gemini. Se lee solo en el backend (process.env.GEMINI_API_KEY).
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo de Gemini a utilizar (configurable).
# Ejemplos vigentes segun la documentacion oficial: gemini-3.8-flash,
# gemini-3.5-flash o el alias gemini-flash-latest.
# Verifica el mas reciente en https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Puerto y host del backend (por defecto solo accesible desde la maquina local).
PORT=8787
HOST=127.0.0.1

# Token opcional para proteger GET /api/health/gemini (defensa en profundidad).
# Si se define, las peticiones deben incluir la cabecera "x-health-token".
HEALTH_CHECK_TOKEN=your_local_health_token_here

# --- Frontend (publico; cualquier variable con prefijo VITE_ queda embebida en el bundle) ---
# URL base del backend para las solicitudes de extraccion.
# Dejalo VACIO para usar el proxy de Vite en desarrollo (recomendado): las
# peticiones a "/api" se reenvian al backend local y se evita CORS.
# Define una URL absoluta solo si el frontend y el backend se sirven por separado.
VITE_API_BASE_URL=

# Opcional (solo desarrollo): destino del proxy de Vite para "/api".
# Por defecto se usa http://127.0.0.1:$PORT (PORT del backend, normalmente 8787).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8787
