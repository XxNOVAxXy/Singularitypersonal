{
  "name": "singularity",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n ai,gmail,client -c blue,magenta,green \"npm:dev:server\" \"npm:dev:gmail\" \"npm:dev\"",
    "dev:gmail": ".venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --reload --port 8000",
    "start:server": "tsx server/index.ts",
    "start:gmail": ".venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --port 8000",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "node --import tsx --test \"server/tests/**/*.test.ts\" \"tests/frontend/**/*.test.ts\"",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^1.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
